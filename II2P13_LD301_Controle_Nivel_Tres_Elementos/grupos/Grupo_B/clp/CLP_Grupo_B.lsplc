           \"type\": \"target\",\n              \"style\": {\n                \"left\": -3\n              }\n            },\n            \"outputConnector\": {\n              \"glbPosition\": {\n                \"x\": 92.0,\n                \"y\": 50\n              },\n              \"relPosition\": {\n                \"x\": 24,\n                \"y\": 12\n              },\n              \"id\": \"output\",\n              \"position\": \"right\",\n              \"isConnectable\": false,\n              \"type\": \"source\",\n              \"style\": {\n                \"right\": -3\n              }\n            },\n            \"numericId\": \"3595326\",\n            \"variable\": {\n              \"name\": \"MODO_AUTO\",\n              \"class\": \"input\",\n              \"type\": {\n                \"definition\": \"base-type\",\n                \"value\": \"BOOL\"\n              },\n              \"location\": \"\",\n              \"initialValue\": null,\n              \"documentation\": \"IHM: FALSE = manual, TRUE = automatico (tres elementos)\",\n              \"debug\": false\n            },\n            \"executionOrder\": 0,\n            \"draggable\": true,\n            \"selectable\": true,\n            \"deletable\": true\n          },\n          \"width\": 24,\n          \"height\": 24,\n          \"measured\": {\n            \"width\": 24,\n            \"height\": 24\n          },\n          \"draggable\": true,\n          \"selectable\": true,\n          \"selected\": false,\n          \"dragging\": false\n        },\n        {\n          \"id\": \"BLOCK_8449bc9d-c13e-4b1a-a14e-a34123a46ed9\",\n          \"type\": \"block\",\n          \"position\": {\n            \"x\": 337.0,\n            \"y\": 14\n          },\n          \"data\": {\n            \"handles\": [\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 50\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 36\n                },\n                \"id\": \"MODO_AUTO\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 36,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 90\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 76\n                },\n                \"id\": \"NIVEL\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 76,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 130\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 116\n                },\n                \"id\": \"VAZAO_VAPOR\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 116,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 170\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 156\n                },\n                \"id\": \"VAZAO_AGUA\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 156,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 210\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 196\n                },\n                \"id\": \"FALHA_NIVEL\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 196,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 250\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 236\n                },\n                \"id\": \"FALHA_VAPOR\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 236,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 290\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 276\n                },\n                \"id\": \"FALHA_AGUA\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 276,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 330\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 316\n                },\n                \"id\": \"SP_NIVEL\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 316,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 370\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 356\n                },\n                \"id\": \"KP_LIC\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 356,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 410\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 396\n                },\n                \"id\": \"TI_LIC\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 396,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 450\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 436\n                },\n                \"id\": \"K_FF\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 436,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 490\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 476\n                },\n                \"id\": \"KP_FIC\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 476,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 530\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 516\n                },\n                \"id\": \"TI_FIC\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 516,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 570\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 556\n                },\n                \"id\": \"MV_MANUAL\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 556,\n                  \"left\": 0\n                }\n              },\n              {\n                \"glbPosition\": {\n                  \"x\": 337.0,\n                  \"y\": 610\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 596\n                },\n                \"id\": \"QMAX_AGUA\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"top\": 596,\n                  \"left\": 0\n                }\n              },\n              {\n                \"