        {
          "id": "dh_in",
          "typeId": "sl.fcn",
          "properties": {
            "Expr": "u(1)*(u(2) < 0.9)/3.6/(896.9*0.6)",
            "SampleTime": "0.01"
          },
          "visual": {
            "x": 0,
            "y": 0,
            "rotation": 0
          },
          "label": "Entrada de água (m/s)"
        },
        {
          "id": "dh_in__mux",
          "typeId": "sl.mux",
          "properties": {
            "Inputs": "2"
          },
          "visual": {
            "x": -80,
            "y": 0,
            "rotation": 0
          }
        },
        {
          "id": "dh_out",
          "typeId": "sl.fcn",
          "properties": {
            "Expr": "(u(1) + 0.24)*(u(2) > 0)/3.6/(896.9*0.6)",
            "SampleTime": "0.01"
          },
          "visual": {
            "x": 0,
            "y": 0,
            "rotation": 0
          },
          "label": "Saída de vapor + purga (m/s)"
        },
        {
          "id": "dh_out__mux",
          "typeId": "sl.mux",
          "properties": {
            "Inputs": "2"
          },
          "visual": {
            "x": -80,
            "y": 0,
            "rotation": 0
          }
        },
        {
          "id": "tambor",
          "typeId": "process.accumulator",
          "properties": {
            "initial": 0.45,
            "samplePeriodNs": 10000000
          },
          "visual": {
            "x": 0,
            "y": 0,
            "rotation": 0
          },
          "label": "Nível físico no tambor (m)"
        },
        {
          "id": "h_aparente",
          "typeId": "sl.fcn",
          "properties": {
            "Expr": "u(1) + 0.00833*u(4)*(u(2) - u(3))",
            "SampleTime": "0.01"
          },
          "visual": {
            "x": 0,
            "y": 0,
            "rotation": 0
          },
          "label": "Nível aparente (m), com inchamento/contração"
        },
        {
          "id": "h_aparente__mux",
          "typeId": "sl.mux",
          "properties": {
            "Inputs": "4"
          },
          "visual": {
            "x": -80,
            "y": 0,
            "rotation": 0
          }
        },
        {
          "id": "nivel_pct",
          "typeId": "sl.fcn",
          "properties": {
            "Expr": "(u(1) - 0.2000)/0.5*100",
            "SampleTime": "0.01"
          },
          "visual": {
            "x": 0,
            "y": 0,
            "rotation": 0
          },
          "label": "Nível entre tomadas (%) - visor LG-101"
        },
        {
          "id": "h_rel",
          "typeId": "sl.fcn",
          "properties": {
            "Expr": "((u(1) - 0.2000) + ((u(1) - 0.2000) < 0)*((0) - (u(1) - 0.2000)) + ((u(1) - 0.2000) > 0.5)*((0.5) - (u(1) - 0.2000)))",
            "SampleTime": "0.01"
          },
          "visual": {
            "x": 0,
            "y": 0,
            "rotation": 0
          },
          "label": "Coluna de água acima da tomada inferior (m)"
        },
