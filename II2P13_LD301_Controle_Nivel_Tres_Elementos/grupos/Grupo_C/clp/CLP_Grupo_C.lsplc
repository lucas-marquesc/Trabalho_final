  "files": {
    "pous/function-blocks/PI_AW.st": "FUNCTION_BLOCK PI_AW\n  VAR_INPUT\n    AUTO : BOOL;      (* TRUE = automatico; FALSE = manual (a saida segue TRACK) *)\n    PV : REAL;        (* variavel de processo, em unidade de engenharia *)\n    SP : REAL;        (* setpoint, na mesma unidade da PV *)\n    KP : REAL;        (* ganho proporcional: unidade da saida por unidade da PV *)\n    TI : REAL;        (* tempo integral em SEGUNDOS (0 = sem acao integral) *)\n    REVERSA : BOOL;   (* TRUE: E = SP - PV (a saida sobe quando a PV fica abaixo do SP) *)\n    TRACK : REAL;     (* valor que a saida segue em manual (transferencia sem salto) *)\n    YMIN : REAL;      (* limite inferior da saida *)\n    YMAX : REAL;      (* limite superior da saida *)\n    TS : REAL;        (* periodo de execucao em segundos (o mesmo da TASK do CLP) *)\n  END_VAR\n  VAR_OUTPUT\n    Y : REAL;         (* saida limitada *)\n    E : REAL;         (* erro usado no calculo *)\n    SAT : BOOL;       (* TRUE enquanto a saida esta num limite *)\n  END_VAR\n  VAR\n    I : REAL;         (* parcela integral acumulada *)\n    U : REAL;         (* saida antes do limite *)\n  END_VAR\n\n(* PI na forma de posicao: Y = KP*E + I, com I(k) = I(k-1) + KP*TS/TI*E. *)\nIF REVERSA THEN\n  E := SP - PV;\nELSE\n  E := PV - SP;\nEND_IF;\n\nIF NOT AUTO THEN\n  (* Manual: recalcula a integral para que, ao voltar ao automatico, a saida comece em TRACK. *)\n  I := TRACK - KP * E;\n  U := TRACK;\nELSE\n  IF TI > 0.0 THEN\n    I := I + KP * TS / TI * E;\n  END_IF;\n  U := KP * E + I;\nEND_IF;\n\n(* Anti-windup: com a saida no limite, a integral e recalculada e para de crescer. *)\nSAT := FALSE;\nIF U > YMAX THEN\n  U := YMAX;\n  I := YMAX - KP * E;\n  SAT := TRUE;\nELSIF U < YMIN THEN\n  U := YMIN;\n  I := YMIN - KP * E;\n  SAT := TRUE;\nEND_IF;\nY := U;\nEND_FUNCTION_BLOCK",
    "pous/function-blocks/CONTROLE_3E.st": "FUNCTION_BLOCK CONTROLE_3E\n  VAR_INPUT\n    MODO_AUTO : BOOL;   (* pedido de automatico (IHM): ligado pela linha de energia do degrau *)\n    NIVEL : REAL;   (* nivel do tambor (% entre tomadas) *)\n    VAZAO_VAPOR : REAL;   (* vazao de vapor (t/h) *)\n    VAZAO_AGUA : REAL;   (* vazao de agua de alimentacao (t/h) *)\n    FALHA_NIVEL : BOOL;   (* sinal do LT-101 invalido (NAMUR NE 43) *)\n    FALHA_VAPOR : BOOL;   (* sinal do FT-101 invalido *)\n    FALHA_AGUA : BOOL;   (* sinal do FT-102 invalido *)\n    SP_NIVEL : REAL;   (* setpoint de nivel (%) *)\n    KP_LIC : REAL;   (* ganho do mestre ((t/h) por %) *)\n    TI_LIC : REAL;   (* tempo integral do mestre (s) *)\n    K_FF : REAL;   (* razao do feedforward *)\n    KP_FIC : REAL;   (* ganho do escravo (% por t/h) *)\n    TI_FIC : REAL;   (* tempo integral do escravo (s) *)\n    MV_MANUAL : REAL;   (* sinal para a valvula em manual (%) *)\n    QMAX_AGUA : REAL;   (* fundo de escala do FT-102 (t/h) *)\n  END_VAR\n  VAR_OUTPUT\n    EM_AUTO : BOOL;   (* malha em automatico (pedido, sem falha e apos a partida) *)\n    ABERTURA : REAL;   (* sinal para a FV-102 (0 a 100 %) *)\n    SP_AGUA : REAL;   (* setpoint do escravo FIC-102 (t/h) *)\n  END_VAR\n  VAR\n    FF_VAPOR : REAL;     (* parcela de antecipacao (t/h) *)\n    TRIM : REAL;         (* correcao do mestre LIC-101 (t/h) *)\n    TRIM_MIN : REAL;\n    TRIM_MAX : REAL;\n    LIMITE_TRIM : REAL;  (* o mestre so corrige +-20 % do fundo de escala da agua *)\n    PARTIDA : TON;       (* 10 s em manual/rastreamento depois que o CLP entra em RUN *)\n    LIC_101 : PI_AW;     (* mestre: nivel -> correcao de vazao *)\n    FIC_102 : PI_AW;     (* escravo: vazao de agua -> abertura da valvula *)\n  END_VAR\n\n(* ============================================================================\n   Controle de nivel do tambor a tres elementos (FORNECIDO - nao altere)\n   nivel (LIC-101, mestre) + vazao de vapor (feedforward) + vazao de agua (FIC-102, escravo)\n   ============================================================================ *)\n\n(* Feedforward: sem medicao de vapor confiavel, a antecipacao sai. *)\nIF FALHA_VAPOR THEN\n  FF_VAPOR := 0.0;\nELSE\n  FF_VAPOR := K_FF * VAZAO_VAPOR;\nEND_IF;\n\n(* Modo: falha no nivel ou na vazao de agua leva a malha para manual.\n   Na partida do CLP os PI rastreiam por 10 s (sem salto na valvula). *)\nPARTIDA(IN := TRUE, PT := T#10s);\nEM_AUTO := MODO_AUTO AND PARTIDA.Q AND NOT FALHA_NIVEL AND NOT FALHA_AGUA;\n\n(* Mestre LIC-101: nivel baixo -> correcao positiva (acao reversa). Com feedforward a saida e uma\n   correcao limitada; sem ele (K_FF = 0) o mestre fornece o setpoint inteiro (dois elementos).\n   Em manual o mestre rastreia (VAZAO_AGUA - FF) para entrar em automatico sem salto. *)\nLIMITE_TRIM := 0.2 * QMAX_AGUA;\nIF K_FF > 0.05 THEN\n  TRIM_MIN := -LIMITE_TRIM;\n  TRIM_MAX := LIMITE_TRIM;\nELSE\n  TRIM_MIN := 0.0;\n  TRIM_MAX := QMAX_AGUA;\nEND_IF;\nLIC_101(AUTO := EM_AUTO, PV := NIVEL, SP := SP_NIVEL, KP := KP_LIC, TI := TI_LIC,\n        REVERSA := TRUE, TRACK := VAZAO_AGUA - FF_VAPOR,\n        YMIN := TRIM_MIN, YMAX := TRIM_MAX, TS := 0.1);\nTRIM := LIC_101.Y;\n\n(* Setpoint do escravo: antecipacao + correcao, na mesma base (t/h). *)\nSP_AGUA := LIMIT(0.0, FF_VAPOR + TRIM, QMAX_AGUA);\n\n(* Escravo FIC-102: vazao abaixo do SP -> abre a valvula (acao reversa). Em manual segue MV_MANUAL. *)\nFIC_102(AUTO := EM_AUTO, PV := VAZAO_AGUA, SP := SP_AGUA, KP := KP_FIC, TI := TI_FIC,\n        REVERSA := TRUE, TRACK := MV_MANUAL,\n        YMIN := 0.0, YMAX := 100.0, TS := 0.1);\nABERTURA := FIC_102.Y;\nEND_FUNCTION_BLOCK",
    "pous/programs/MAIN.ld": "PROGRAM MAIN\n  VAR_INPUT\n    AI_LT101 : REAL;   (* AI-01: tensao no shunt de 250 ohm (1 a 5 V) - LT-101 nivel do tambor *)\n    AI_FT101 : REAL;   (* AI-02: tensao no shunt de 250 ohm (1 a 5 V) - FT-101 vazao de vapor *)\n    AI_FT102 : REAL;   (* AI-03: tensao no shunt de 250 ohm (1 a 5 V) - FT-102 vazao de agua *)\n    SP_NIVEL : REAL;   (* IHM: setpoint de nivel do LIC-101 (%) *)\n    KP_LIC : REAL;   (* IHM: ganho do mestre LIC-101 ((t/h) por %) *)\n    TI_LIC : REAL;   (* IHM: tempo integral do mestre (s) *)\n    K_FF : REAL;   (* IHM: razao do feedforward (t/h de agua por t/h de vapor) *)\n    KP_FIC : REAL;   (* IHM: ganho do escravo FIC-102 (% por t/h) *)\n    TI_FIC : REAL;   (* IHM: tempo integral do escravo (s) *)\n    MODO_AUTO : BOOL;   (* IHM: FALSE = manual, TRUE = automatico (tres elementos) *)\n    MV_MANUAL : REAL;   (* IHM: sinal para a FV-102 em manual (%) *)\n  END_VAR\n  VAR_OUTPUT\n    AO_FV102 : REAL;   (* AO-01: corrente para o FY-102 em mA (4 mA = fechada, 20 mA = aberta) *)\n  END_VAR\n  VAR\n    CONTROLE : CONTROLE_3E;   (* controle a tres elementos (bloco fornecido) *)\n    NIVEL : REAL;   (* ETAPA 3: nivel do tambor (%) *)\n    VAZAO_VAPOR : REAL;   (* ETAPA 4: vazao de vapor (t/h) - placa FE-101 *)\n    VAZAO_AGUA : REAL;   (* ETAPA 4: vazao de agua (t/h) - placa FE-102 *)\n    FALHA_LT101 : BOOL;   (* ETAPA 2: sinal do LT-101 fora de 3,6 a 21 mA *)\n    FALHA_FT101 : BOOL;   (* ETAPA 2: sinal do FT-101 fora de 3,6 a 21 mA *)\n    FALHA_FT102 : BOOL;   (* ETAPA 2: sinal do FT-102 fora de 3,6 a 21 mA *)\n    QMAX_AGUA : REAL;   (* fundo de escala do FT-102 (t/h): preencha o valor inicial *)\n    ABERTURA : REAL;   (* sinal para a FV-102 (%) *)\n    EM_AUTO : BOOL;   (* malha em automatico *)\n    SP_AGUA : REAL;   (* setpoint do escravo (t/h) *)\n    AO_X : REAL;   (* auxiliar da saida analogica *)\n  END_VAR\n\n\n{\n  \"name\": \"MAIN\",\n  \"rungs\": [\n    {\n      \"id\": \"rung_MAIN_d27a9584-205a-49ac-b927-fc81c6279fd8\",\n      \"comment\": \"II2P13 - TRABALHO: escreva em LADDER as ETAPAS 1 a 4 em degraus ACIMA deste (botao + Rung e arraste). ETAPA 1: corrente de cada AI (mA) = V / 0,25. ETAPA 2: FALHA = I < 3,6 mA OU I > 21 mA (NAMUR NE 43). ETAPA 3: NIVEL (%) pela faixa do LT-101. ETAPA 4: vazao de cada placa de orificio (t/h): dP pela faixa do transmissor, corte de vazao baixa e raiz quadrada. Dica: um bloco por degrau (a saida de um bloco so e gravada no fim do degrau). ETAPA 5 (FORNECIDA): controle a tres elementos.\",\n      \"defaultBounds\": [\n        300,\n        100\n      ],\n      \"reactFlowViewport\": [\n        939,\n        654\n      ],\n      \"selectedNodes\": [],\n      \"nodes\": [\n        {\n          \"id\": \"left-rail-rung_MAIN_d27a9584-205a-49ac-b927-fc81c6279fd8\",\n          \"type\": \"powerRail\",\n          \"position\": {\n            \"x\": 0,\n            \"y\": 30\n          },\n          \"data\": {\n            \"handles\": [\n              {\n                \"glbPosition\": {\n                  \"x\": 3,\n                  \"y\": 50\n                },\n                \"relPosition\": {\n                  \"x\": 3,\n                  \"y\": 20\n                },\n                \"id\": \"left-rail\",\n                \"position\": \"right\",\n                \"isConnectable\": false,\n                \"type\": \"source\",\n                \"style\": {\n                  \"right\": -3\n                }\n              }\n            ],\n            \"variant\": \"left\",\n            \"outputConnector\": {\n              \"glbPosition\": {\n                \"x\": 3,\n                \"y\": 50\n              },\n              \"relPosition\": {\n                \"x\": 3,\n                \"y\": 20\n              },\n              \"id\": \"left-rail\",\n              \"position\": \"right\",\n              \"isConnectable\": false,\n              \"type\": \"source\",\n              \"style\": {\n                \"right\": -3\n              }\n            },\n            \"outputHandles\": [\n              {\n                \"glbPosition\": {\n                  \"x\": 3,\n                  \"y\": 50\n                },\n                \"relPosition\": {\n                  \"x\": 3,\n                  \"y\": 20\n                },\n                \"id\": \"left-rail\",\n                \"position\": \"right\",\n                \"isConnectable\": false,\n                \"type\": \"source\",\n                \"style\": {\n                  \"right\": -3\n                }\n              }\n            ],\n            \"inputHandles\": [],\n            \"numericId\": \"7147401\",\n            \"variable\": {\n              \"name\": \"\"\n            },\n            \"executionOrder\": 0,\n            \"draggable\": false,\n            \"selectable\": true,\n            \"deletable\": false\n          },\n          \"width\": 3,\n          \"height\": 40,\n          \"measured\": {\n            \"width\": 3,\n            \"height\": 40\n          },\n          \"draggable\": false,\n          \"selectable\": true,\n          \"selected\": false,\n          \"dragging\": false\n        },\n        {\n          \"id\": \"CONTACT_131793ce-58f4-4338-8273-1d63193b549a\",\n          \"type\": \"contact\",\n          \"position\": {\n            \"x\": 68.0,\n            \"y\": 38\n          },\n          \"data\": {\n            \"handles\": [\n              {\n                \"glbPosition\": {\n                  \"x\": 68.0,\n                  \"y\": 50\n                },\n                \"relPosition\": {\n                  \"x\": 0,\n                  \"y\": 12\n                },\n                \"id\": \"input\",\n                \"position\": \"left\",\n                \"isConnectable\": false,\n                \"type\": \"target\",\n                \"style\": {\n                  \"left\": -3\n                }\n              },\n              {\n                \"glbPositi